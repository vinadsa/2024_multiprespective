# Copy this file to `.env` and adjust. Every value is optional;
# defaults reproduce the original hardcoded setup.

# --- Kafka ---
KAFKA_BROKERS=localhost:29092,localhost:29093,localhost:29094
KAFKA_TOPIC_EVENTS=pm.test.events.raw
KAFKA_TOPIC_WATERMARK=pm.test.events.watermark
KAFKA_TOPIC_DLQ=pm.test.events.dlq
KAFKA_GROUP_ID=gotr_consumer_group_7
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=2

# --- Neo4j ---
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678

# --- Services ---
CONSUMER_PORT=8000
PRODUCER_PORT=8100

# --- Process model loaded at consumer startup (.csv / .xes / .pnml) ---
# Relative paths are resolved against OnlineApps/Backend
MODEL_SOURCE_PATH=../../process_mining/media/datacsv_repair.csv
MODEL_CASE_COL=case_id
MODEL_ACTIVITY_COL=activity
MODEL_TIMESTAMP_COL=timestamp
MODEL_NOISE_THRESHOLD=0.0

# --- Organizational model (.yaml / .yml / .json). Leave empty to run control-flow only ---
ORG_MODEL_PATH=models/org_model.repair.yaml
UPLOAD_DIR=models/uploads

# --- Case completion: any combination of end_signal, final_marking, timeout ---
# Replay XES   : end_signal,final_marking
# Real stream  : final_marking,timeout
CASE_END_STRATEGY=end_signal,final_marking
CASE_IDLE_TIMEOUT_SEC=30
CASE_SWEEP_INTERVAL_SEC=15

# --- Streamer ---
PRODUCER_WEBHOOK_URL=http://localhost:8100/events
STREAMER_XES_FILES=data/output_logv2test2.xes
STREAMER_MODE=fixed_interval
STREAMER_SPEED=1.0
STREAMER_FIXED_INTERVAL_MS=5000
XES_ACTIVITY_KEY=concept:name
XES_RESOURCE_KEYS=org:resource,resource
XES_CASE_KEY=concept:name
